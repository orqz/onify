# Maintainer: orqz
#
# onify as a normal Arch package: pacman installs it to /usr, yay updates it.
# Builds the release tagged v$pkgver. Locally: `makepkg -si` in this folder.
# For the AUR, copy this file there with `makepkg --printsrcinfo > .SRCINFO`.

pkgname=onify
pkgver=0.1.4.1
pkgrel=1
pkgdesc="A smooth, lightweight Spotify client (needs Spotify Premium)"
arch=('x86_64' 'aarch64')
url="https://github.com/orqz/onify"
license=('MIT')
depends=('gtk4' 'libadwaita' 'pango' 'graphene' 'glib2' 'libpulse' 'openssl' 'libgcc' 'glibc' 'hicolor-icon-theme')
makedepends=('cargo' 'git')
source=("$pkgname::git+https://github.com/orqz/onify.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

package() {
    cd "$pkgname"
    install -Dm755 target/release/onify "$pkgdir/usr/bin/onify"
    install -Dm644 data/io.github.orqz.onIfy.desktop "$pkgdir/usr/share/applications/io.github.orqz.onIfy.desktop"
    install -Dm644 data/icons/io.github.orqz.onIfy.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.orqz.onIfy.svg"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
